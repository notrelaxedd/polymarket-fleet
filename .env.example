# Copy to .env and edit. Every variable is optional; defaults shown.

# Postgres connection string used by the host and the CLI.
# In docker-compose the host container overrides this to reach the db service.
#DATABASE_URL=postgresql://fleet:fleet@db:5432/fleet

# URL workers and the installer use to reach the host (the tailscale serve URL).
#FLEET_PUBLIC_URL=http://127.0.0.1:8080

# Tailscale login that owns the dashboard. Requests must carry
# Tailscale-User-Login equal to this value (injected by tailscale serve).
#FLEET_OWNER_LOGIN=you@example.com

# Set to 1 to skip the owner header check (local development only).
#FLEET_DEV=0

# Comma separated Origins allowed on state-changing owner requests.
# Defaults to FLEET_PUBLIC_URL.
#FLEET_ALLOWED_ORIGINS=http://127.0.0.1:8080

# host:port the API binds to. Keep it on loopback (or the tailscale IP);
# never 0.0.0.0 outside a container. The container sets 0.0.0.0:8080 itself.
#FLEET_BIND=127.0.0.1:8080

# Directory holding install_worker.sh (served as /install.sh).
#FLEET_DEPLOY_DIR=/app/deploy

# Seconds between reaper + dispatcher passes.
#FLEET_LOOP_SECONDS=5

# Owner requests coming from a registered worker's IP are refused (a compromised
# job must not reach owner routes). Set to 1 only if you must use the dashboard
# from a machine that is also a worker.
#FLEET_OWNER_ALLOW_WORKER_IPS=0

# The app sits behind tailscale serve, which appends the tailnet peer as the last
# X-Forwarded-For hop; that hop is the peer IP recorded on workers and checked above.
# Set to 0 when clients reach the port directly (the socket peer is used instead).
#FLEET_TRUST_PROXY=1
