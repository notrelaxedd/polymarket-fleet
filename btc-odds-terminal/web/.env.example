# BTC Odds Terminal frontend. Next.js does not read this file: copy it to web/.env.local
# (cp .env.example .env.local) for `npm run dev` or `npm run build`.
# NEXT_PUBLIC_* values are inlined at BUILD time. After changing one, restart `npm run dev`,
# rebuild, or on Vercel redeploy. They are sent to every browser: never put secrets here.

# Backend REST base URL, no trailing slash.
# Local default below. For Vercel, use the worker's tailscale serve HTTPS URL, for example
# https://worker-name.your-tailnet.ts.net
NEXT_PUBLIC_API_URL=http://localhost:8787

# Backend WebSocket URL. Use wss:// when the page is served over https (Vercel). Browsers
# block ws:// from an https page.
NEXT_PUBLIC_WS_URL=ws://localhost:8787/ws

# 1 = synthetic data, no backend needed. 0 = live data from the backend.
# You can also force mock mode for one page load with ?mock=1 in the URL.
NEXT_PUBLIC_MOCK=0
