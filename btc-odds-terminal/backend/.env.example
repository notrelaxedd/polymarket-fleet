# BTC Odds Terminal backend. install.sh copies this to backend/.env on first run.
# Format: plain KEY=value, one per line. No quotes, no spaces around "=", no "$" or
# backticks in values (the seed step sources this file with a shell).
# Keep .env chmod 600 and never commit it. Relative paths resolve from backend/.

# Port for REST (under /api) and the WebSocket (at /ws).
PORT=8787

# Interface to bind. Default 127.0.0.1 (loopback only); reach it from the tailnet via
# `tailscale serve`. The API has NO login of its own: anyone who can reach it can read
# live state and, once live trading exists, place orders. Use 0.0.0.0 only on a trusted
# network. Never expose it to the internet (no tailscale funnel, no public port).
# Use a literal address (127.0.0.1, 0.0.0.0, :: or ::1): install.sh builds its health-check
# URL from it.
HOST=127.0.0.1

# SQLite file for ticks, odds, windows, orders, fills, positions, drawings, alerts, settings.
# The directory must exist and be writable by the btcodds user (install.sh creates backend/data).
# Under the systemd unit, DB_PATH must stay inside backend/data: the unit sets
# ProtectSystem=strict with ReadWritePaths=/opt/btc-odds-terminal/backend/data, so any other
# path fails with a read-only filesystem error on every start. To use another directory, add it
# to ReadWritePaths in backend/deploy/btc-odds-terminal.service first.
DB_PATH=./data/terminal.db

# Comma-separated origins allowed to call the API from a browser on another origin,
# e.g. http://localhost:3000,https://your-app.vercel.app. Replace this default with your
# Vercel origin if you use one. "*" allows any origin, so any web page open in a browser that
# can reach this host could change settings; the API has no login. install.sh warns if it is "*".
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# TRADING_MODE, VOL_LOOKBACK_MIN and FEE_CENTS_PER_CONTRACT are DEFAULTS for the app's settings.
# Once you change one in the app (PUT /api/settings), the stored value wins and later edits to
# that variable here are ignored. Settings you never changed keep following this file.
#
# paper = simulated fills that walk the real order book and apply the slippage cap and fees.
#         This is the default. Nothing is sent to Polymarket.
# live  = real orders on Polymarket US, using the keys below. This variable is NOT a gate: the
#         app can switch to live (Settings -> Mode) whenever both keys below are set, and the API
#         has no login. Each browser session must confirm live trading in a dialog before its
#         first live order (POST /api/live/confirm). See README "Going live".
TRADING_MODE=paper

# Lookback in minutes for the realized volatility (sigma) in the fair-value formula.
VOL_LOOKBACK_MIN=30

# Taker fee in cents per contract. Leave blank until the Polymarket US fee schedule is
# confirmed: blank means unconfirmed, and the UI shows [FEE] instead of a number.
# Do not guess a value.
FEE_CENTS_PER_CONTRACT=

# Polymarket US public gateway: market discovery, BBO, book and settlement. No key needed.
POLY_GATEWAY_URL=https://gateway.polymarket.us

# How often the backend polls Polymarket US BBO, in milliseconds.
POLY_POLL_MS=1000

# Ed25519 key ID and secret from polymarket.us/developer. Backend only: never give these to
# the frontend, never commit them. Optional. With both set, the backend signs and opens the
# authenticated markets WebSocket (wss://api.polymarket.us/v1/ws/markets) even in paper mode, and
# the app is allowed to switch to live. Leave blank to poll the public gateway only.
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET=

# Markets WebSocket: auto = use it when both keys are set, else poll | off = always poll
# | noauth = try it unsigned (falls back to polling while it fails).
# POLY_WS_MODE=auto
# POLY_WS_URL=wss://api.polymarket.us/v1/ws/markets
# REST timeout in milliseconds.
# POLY_TIMEOUT_MS=5000

# Market discovery overrides. How the 15m BTC series is found and where the price to beat lives
# are UNVERIFIED guesses (docs/POLYMARKET_US.md). If the app shows "no active window", follow
# the recovery procedure there, then set whichever of these fixes it and restart. When no price
# to beat is found in the metadata, the BRTI proxy price at window start is used instead.
# POLY_SEARCH_QUERY=Bitcoin Up or Down
# POLY_SERIES_ID=
# POLY_TAG_SLUG=
# Exchanges in the BTC "BRTI proxy" (comma list of coinbase,kraken,bitstamp; default all three).
# Leave out one your network blocks (log shows "Opening handshake has timed out" forever), e.g.
# BTC_EXCHANGES=kraken,bitstamp
# BTC_EXCHANGES=coinbase,kraken,bitstamp
# POLY_SLUG_REGEX=
# Discovery looks up the previous/current/next windows directly by event slug, built from the
# window's UTC start (seen live 2026-10-21: btc-updown-15m-2026-10-21-1415z). Text search is the
# fallback. Tokens: {YYYY} {MM} {DD} {HH} {mm}. Set to "off" to use search only.
# POLY_EVENT_SLUG_TEMPLATE=btc-updown-15m-{YYYY}-{MM}-{DD}-{HH}{mm}z
# Minimum gap between requests to the public gateway, all callers combined (ms). The gateway is behind
# Cloudflare and rate-limits (HTTP 429, "Error 1015"); the gap doubles on every 429 and recovers slowly.
# Raise it if the Polymarket dot still flaps with "rate limited". With API keys the odds come over the
# WebSocket instead and this matters much less.
# POLY_MIN_GAP_MS=1000
# POLY_PTB_FIELDS=priceToBeat,price_to_beat,strikePrice,strike,threshold,line,referencePrice,openPrice,startPrice,targetPrice

# Live trading (docs/POLYMARKET_US.md "Live trading"). The last three are UNVERIFIED guesses:
# check POLY_SHORT_PRICE_QUOTE with a tiny Down order before trading Down for real.
# POLY_API_URL=https://api.polymarket.us
# POLY_PRIVATE_WS_URL=wss://api.polymarket.us/v1/ws/private
# LIVE_RECONCILE_MS=15000
# POLY_SHORT_PRICE_QUOTE=short
# POLY_QTY_STEP=1
# POLY_TICK_CENTS=1

# Hours of BTC history that `npm run seed` backfills as 60-second bars (from
# api.exchange.coinbase.com), so the chart is not empty on first load. install.sh runs the
# seed on each run until it succeeds once.
SEED_HOURS=6

# pino log level: fatal | error | warn | info | debug | trace.
# Logs go to stdout as JSON lines; under systemd, read them with journalctl.
LOG_LEVEL=info
